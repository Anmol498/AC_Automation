PORT=3000
MYSQL_HOST=localhost
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ac_automation
JWT_SECRET=your_jwt_secret
NODE_ENV=development
DEFAULT_ADMIN_PASSWORD=your_default_superadmin_password_min_12_chars


# --- STORAGE CONFIGURATION ---
# Absolute path to persistent storage (e.g., /home/username/persistent_uploads)
# Fallback is 'uploads' folder in project root if not set
# UPLOAD_DIR=/absolute/path/to/persistent_uploads

# --- EMAIL CONFIGURATION ---
# Default sender (for general system notifications if needed)
EMAIL_USER=contact@satguruengineers.com
EMAIL_FROM="Satguru Engineers"

# SMTP Transport (for contact@satguruengineers.com)
SMTP_HOST=satguruengineers.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@satguruengineers.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=true
SMTP_FROM_NAME="Satguru Engineers"
SMTP_REJECT_UNAUTHORIZED=true


# Google OAuth Transport (for contactsatguruengineers@gmail.com)
GMAIL_USER=contactsatguruengineers@gmail.com
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_FROM_NAME="Satguru Engineers"